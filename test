import React, { useState } from 'react';
import { Card, CardContent, Typography, TextField, Button, IconButton, Box } from '@mui/material';
import CloseIcon from '@mui/icons-material/Close';
import './Overlay.css'; // Import CSS for overlay styling

const Overlay = ({ show, onClose }) => {
  const [selectedOption, setSelectedOption] = useState('');
  const [numberValue, setNumberValue] = useState('');

  const handleDropdownChange = (e) => {
    setSelectedOption(e.target.value);
  };

  const handleNumberChange = (e) => {
    setNumberValue(e.target.value);
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    alert(`Selected option: ${selectedOption}, Number value: ${numberValue}`);
    onClose();
  };

  const handleOverlayClick = (e) => {
    if (e.target === e.currentTarget) {
      onClose();
    }
  };

  return (
    <div className={`overlay ${show ? 'show' : ''}`} onClick={handleOverlayClick}>
      <div className="overlay-content" onClick={(e) => e.stopPropagation()}>
        <Card>
          <CardContent>
            <Box display="flex" justifyContent="flex-end">
              <IconButton onClick={onClose}>
                <CloseIcon />
              </IconButton>
            </Box>
            <Typography variant="h6" gutterBottom>
              Form Overlay
            </Typography>
            <form onSubmit={handleSubmit}>
              <TextField
                select
                label="Select an option"
                value={selectedOption}
                onChange={handleDropdownChange}
                fullWidth
                margin="normal"
                required
                SelectProps={{
                  native: true,
                }}
              >
                <option value="">Select...</option>
                <option value="option1">Option 1</option>
                <option value="option2">Option 2</option>
                <option value="option3">Option 3</option>
              </TextField>
              <TextField
                label="Enter a number"
                type="number"
                value={numberValue}
                onChange={handleNumberChange}
                fullWidth
                margin="normal"
                required
              />
              <Button type="submit" variant="contained" color="primary">
                Submit
              </Button>
            </form>
          </CardContent>
        </Card>
      </div>
    </div>
  );
};

export default Overlay;



.overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: none;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.overlay.show {
  display: flex;
}

.overlay-content {
  position: relative;
  max-width: 600px;
  width: 100%;
  padding: 20px;
  background-color: white;
  border-radius: 8px;
  box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.3);
}
